  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1.6.1",
    "@sap/cds": "^8.7.1",
    "@sap/cds-mtxs": "^2.5.1",
    "@sap/xssec": "^4.3.0",
    "express": "^4.21.2",
    "glob": "^11.0.1"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1.8.0",
    "@sap/cds-dk": "^8.7.1",
    "mbt": "^1.2.29",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-studentfronted": "cds watch --open studentfronted/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy incident-management --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "sql": {
      "native_hana_associations": false
    },
    "server": {
      "index": true
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "tenant": "t1",
              "password": "alice",
              "roles": [
                "support"
              ]
            },
            "bob": {
              "roles": [
                "support"
              ]
            },
            "erin": {
              "tenant": "t2",
              "password": "erin",
              "roles": [
                "support"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "[local-multitenancy]": {
        "multitenancy": true
      }
    },
    "profile": "with-mtx-sidecar"
  }
}
